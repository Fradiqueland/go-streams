{
  "name": "streamland",
  "version": "1.3.2",
  "private": true,
  "type": "module",
  "description": "Local video playout and RTMP streaming studio",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs --open",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:wire": "node --test --test-concurrency=1 test/optional/wire.test.mjs",
    "test:ui": "node scripts/ui-check.mjs",
    "build:installer": "python scripts/build-windows-installer.py",
    "build:electron": "python scripts/build-electron-windows.py",
    "test:live": "node --test test/live-capture.test.mjs test/optional/live-wire.test.mjs",
    "test:live:browser": "node scripts/verify-live-browser.mjs",
    "test:review": "node scripts/review-loop.mjs 10",
    "test:recorder:browser": "node scripts/verify-recorder-browser.mjs"
  },
  "main": "electron/main.cjs"
}
