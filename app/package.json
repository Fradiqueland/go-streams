{
  "name": "go-streams",
  "version": "0.15.5",
  "private": true,
  "type": "module",
  "description": "Local video playout and RTMP streaming studio",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/server.mjs --open",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "check": "node scripts/check.mjs",
    "test:wire": "node --test --test-concurrency=1 test/optional/wire.test.mjs",
    "test:ui": "node scripts/ui-check.mjs"
  }
}
